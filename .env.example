# ─────────────────────────────────────────────────────────────────────────────
# Simply Black and White — Environment Variables
# Copy this file to .env and fill in your values before running the app.
# NEVER commit your .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Session ─────────────────────────────────────────────────────────────────
# Generate a strong random string (e.g., run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=replace_with_a_long_random_string

# ─── Database ────────────────────────────────────────────────────────────────
# Path to the SQLite database file.
# On Railway: set this to /data/sbw.db (matches the persistent volume mount)
# Locally: leave as default (will create ./data/sbw.db)
DB_PATH=./data/sbw.db

# ─── Google OAuth2 ───────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://yourdomain.com/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Callback URL (use http://localhost:3000/auth/google/callback for local dev)
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Only this Google account is allowed to access the /scanner dashboard
ALLOWED_GOOGLE_EMAIL=frictionlessaccess@gmail.com,icreate.com@gmail.com

# ─── Notifications (Gmail SMTP) ──────────────────────────────────────────────
# Use a Gmail App Password (NOT your regular Gmail password).
# Enable 2FA on your Google account, then generate an App Password at:
# https://myaccount.google.com/apppasswords
RESEND_API_KEY=your_resend_api_key_here
NOTIFY_EMAIL_FROM=onboarding@resend.dev
NOTIFY_EMAIL_TO=frictionlessaccess@gmail.com

# ─── App URL ─────────────────────────────────────────────────────────────────
# Used for building absolute URLs in notifications and schema markup.
# Locally: http://localhost:3000
# Production: https://simplyblackandwhite.com
APP_URL=http://localhost:3000
